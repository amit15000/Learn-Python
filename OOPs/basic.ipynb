    "class RateLimiter:\n",
    "    limit = 100\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.used = 0\n",
    "\n",
    "\n",
    "r1 = RateLimiter()\n",
    "r2 = RateLimiter()\n",
    "\n",
    "print(r1.used)\n",
    "print(r2.used)\n",
    "\n",
    "r1.used = 10\n",
    "\n",
    "r1.limit -= r1.used\n",
    "print(r1.used, r1.limit)\n",
    "print(r2.used, r2.limit)\n"
   ]
